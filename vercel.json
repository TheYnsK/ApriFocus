{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "client/package.json", "use": "@vercel/static-build" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },

    { "src": "/assets/(.*)", "dest": "/client/assets/$1" },
    { "src": "/logo\\.svg", "dest": "/client/logo.svg" },

    { "handle": "filesystem" },

    { "src": "/(.*)", "dest": "/client/index.html" }
  ]
}
